{
  "name": "components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006",
    "build": "biome ci . && tsc -b && storybook build --output-dir dist --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "deploy": "bun run build && wrangler deploy",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "lefthook": "2.2.2",
    "playwright": "^1.64.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
